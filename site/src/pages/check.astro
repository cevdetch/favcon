---
// The CDP harness supplies source and native references. No fixtures or reference endpoint
// are shipped in the public bundle.
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>favseed browser self-check</title><meta name="robots" content="noindex" /></head>
<body><h1>favseed browser self-check</h1><pre id="out">loading…</pre>
<script>
  import { buildInBrowser, warm, dispose } from '../lib/pipeline.mjs';
  const hash = async (bytes) => Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)),
    (n) => n.toString(16).padStart(2, '0')).join('');
  const summary = async (built) => ({
    files: await Promise.all(built.files.map(async ({ name, bytes }) => ({ name, hash: await hash(bytes), size: bytes.length }))),
    fit: built.fit, links: built.links, animated: built.animated,
  });
  const checkArchive = (built) => {
    const archive = built.archive(), view = new DataView(archive.buffer);
    let at = 0;
    for (const file of built.files) {
      if (view.getUint32(at, true) !== 0x04034b50 || view.getUint16(at + 8, true) !== 0 ||
          view.getUint16(at + 10, true) !== 0 || view.getUint16(at + 12, true) !== 0x0021) throw new Error('Bad ZIP header');
      const length = view.getUint32(at + 18, true), nameLength = view.getUint16(at + 26, true);
      const extra = view.getUint16(at + 28, true);
      const name = new TextDecoder().decode(archive.subarray(at + 30, at + 30 + nameLength));
      const offset = at + 30 + nameLength + extra;
      if (name !== file.name || length !== file.bytes.length ||
          !file.bytes.every((b, i) => b === archive[offset + i])) throw new Error('ZIP file differs: ' + file.name);
      at = offset + length;
    }
    if (view.getUint32(at, true) !== 0x02014b50) throw new Error('Missing ZIP directory');
  };
  window.favseedCheck = {
    isolated: globalThis.crossOriginIsolated,
    warm, dispose,
    async unsupported() {
      dispose();
      const descriptor = Object.getOwnPropertyDescriptor(globalThis, 'crossOriginIsolated');
      Object.defineProperty(globalThis, 'crossOriginIsolated', { configurable: true, value: false });
      try {
        await warm();
        throw new Error('Unsupported environment accepted');
      } catch (e) {
        if (!/cross-origin isolation.*favseed CLI/.test(e.message)) throw e;
        return true;
      } finally {
        if (descriptor) Object.defineProperty(globalThis, 'crossOriginIsolated', descriptor);
        else delete globalThis.crossOriginIsolated;
      }
    },
    async build(source, options) {
      let ticks = 0, maxGap = 0, last = performance.now();
      const timer = setInterval(() => { const now = performance.now(); maxGap = Math.max(maxGap, now - last); last = now; ticks++; }, 20);
      const start = performance.now(), progress = [];
      try {
        const built = await buildInBrowser(source, options, { onProgress: (e) => progress.push(e) });
        const ms = performance.now() - start;
        checkArchive(built);
        return { ...(await summary(built)), ms, ticks, maxGap, progress, archiveHash: await hash(built.archive()) };
      } finally { clearInterval(timer); }
    },
    async cache(source, options) {
      const first = await buildInBrowser(source, options), expected = structuredClone(await summary(first));
      const archive = first.archive(); archive.fill(0);
      for (const file of first.files) file.bytes.fill(0);
      first.fit.apple.box = -1;
      const second = await buildInBrowser(source, options);
      checkArchive(second);
      if (JSON.stringify(await summary(second)) !== JSON.stringify(expected)) throw new Error('Cache bytes or metadata were mutated');
      return true;
    },
    async cancel(source, options, phase) {
      const controller = new AbortController();
      const timer = phase === 'initialization' ? setTimeout(() => controller.abort(), 5) : undefined;
      try {
        await buildInBrowser(source, options, { signal: controller.signal,
          onProgress: (e) => { if (e.phase === phase) setTimeout(() => controller.abort(), 10); } });
        throw new Error('Cancelled build resolved');
      } catch (e) { if (e.name !== 'AbortError') throw e; return true; }
      finally { clearTimeout(timer); }
    },
    async invalid(source) {
      for (const options of [{ padding: 'foo' }, { sizes: [33] }, { colors: 300 }, { mode: 'unknown' }, { quality: 0 }, { quality: 101 }, { quality: [80] }, { quality: 80, colors: 256 }]) {
        let rejected = false;
        try { await buildInBrowser(source, options); } catch { rejected = true; }
        if (!rejected) throw new Error('Invalid options accepted');
      }
      return true;
    },
  };
  document.getElementById('out').textContent = 'ready';
</script></body></html>
